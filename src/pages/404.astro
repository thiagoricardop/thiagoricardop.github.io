---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { person } from '../data/profile';
---

<BaseLayout title={`Page not found | ${person.name}`} noindex>
  <main id="main" class="grid min-h-screen place-items-center px-6 text-center">
    <div>
      <p class="font-mono text-sm text-cyan-700 dark:text-cyan-400">404 · UNKNOWN_ID</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight">This page is not on the bus.</h1>
      <p class="mt-4">The address you followed does not exist.</p>
      <a href="/" class="btn-primary mt-8">
        Back to the portfolio
        <Icon name="arrowRight" class="size-4" />
      </a>
    </div>
  </main>
</BaseLayout>
