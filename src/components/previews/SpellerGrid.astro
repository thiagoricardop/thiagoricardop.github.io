---
const rows = ['ABCDEF', 'GHIJKL', 'MNOPQR', 'STUVWX', 'YZ1234', '56789_'];
// One flashed row and one flashed column; their intersection is the target.
const flashedRow = 2;
const flashedCol = 3;
---

<div class="flex h-full flex-col bg-black font-mono">
  <div class="flex items-center justify-between border-b border-slate-800 px-4 py-2.5 text-[11px] text-slate-400 sm:text-xs">
    <span>P300 Speller · color highlight</span>
    <span>6 × 6 matrix</span>
  </div>
  <div class="grid flex-1 place-items-center p-4">
    <div class="grid grid-cols-6 gap-1.5 sm:gap-2">
      {rows.flatMap((row, r) =>
        [...row].map((char, c) => {
          const isTarget = r === flashedRow && c === flashedCol;
          const flashed = r === flashedRow || c === flashedCol;
          return (
            <span
              class:list={[
                'grid size-7 place-items-center rounded text-sm font-semibold sm:size-8 sm:text-base',
                isTarget
                  ? 'bg-cyan-400 text-black ring-2 ring-cyan-200'
                  : flashed
                    ? 'bg-cyan-950 text-cyan-300'
                    : 'text-slate-500',
              ]}
            >
              {char}
            </span>
          );
        }),
      )}
    </div>
  </div>
</div>
