---
import Section from './Section.astro';
import { about, focusAreas } from '../data/profile';
---

<Section id="about" eyebrow="01 · About" title="Securing the software inside connected vehicles">
  <div class="grid gap-10 lg:grid-cols-[1fr_20rem]">
    <div class="space-y-5 text-lg leading-relaxed">
      {about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <aside class="card h-fit p-6" aria-labelledby="focus-title">
      <h3 id="focus-title" class="font-mono text-sm font-medium text-cyan-700 dark:text-cyan-400">
        Current focus
      </h3>
      <ul class="mt-4 space-y-3">
        {focusAreas.map((area) => (
          <li class="flex gap-3">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-cyan-500" aria-hidden="true" />
            <span>{area}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</Section>
