---
import Section from './Section.astro';
import { skills } from '../data/profile';
---

<Section
  id="skills"
  eyebrow="04 · Skills"
  title="Technical skills"
  intro="Solid tags are skills I have applied in professional work or public projects. Dashed tags come from graduate coursework and labs."
>
  <div class="mb-8 flex flex-wrap gap-4 text-sm" aria-hidden="true">
    <span class="flex items-center gap-2">
      <span class="chip bg-cyan-100 text-cyan-900 dark:bg-cyan-950 dark:text-cyan-200">
        Hands-on
      </span>
      projects and work
    </span>
    <span class="flex items-center gap-2">
      <span class="chip border border-dashed border-slate-300 text-slate-600 dark:border-slate-700 dark:text-slate-400">
        Coursework
      </span>
      graduate training
    </span>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {skills.map((group) => (
      <div class="card p-6">
        <h3 class="font-semibold">{group.name}</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {group.handsOn.map((skill) => (
            <li class="chip bg-cyan-100 text-cyan-900 dark:bg-cyan-950 dark:text-cyan-200">
              {skill}
            </li>
          ))}
          {group.coursework.map((skill) => (
            <li class="chip border border-dashed border-slate-300 text-slate-600 dark:border-slate-700 dark:text-slate-400">
              {skill}
              <span class="sr-only"> (coursework)</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
