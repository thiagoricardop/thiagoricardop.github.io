---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import profilePhoto from '../assets/profile.jpg';
import { education, person, stats } from '../data/profile';

const currentDegree = education[0];
---

<section id="top" class="relative overflow-hidden">
  <div class="grid-backdrop pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 pt-16 pb-20 sm:pt-24 lg:grid-cols-[1fr_auto]">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
        <span class="size-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
        {person.availability}
      </p>

      <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-6xl">{person.name}</h1>
      <p class="mt-3 text-xl font-medium text-cyan-700 sm:text-2xl dark:text-cyan-400">
        {person.role}
      </p>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed">{person.headline}</p>

      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <li class="flex items-center gap-2">
          <Icon name="mapPin" class="size-4 text-slate-500" />
          {person.location}
        </li>
        <li class="flex items-center gap-2">
          <Icon name="shieldCheck" class="size-4 text-slate-500" />
          {person.workAuthorization}
        </li>
        <li class="flex items-center gap-2">
          <Icon name="graduationCap" class="size-4 text-slate-500" />
          {currentDegree.degree}, {currentDegree.school}
        </li>
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#projects" class="btn-primary">
          View projects
          <Icon name="arrowRight" class="size-4" />
        </a>
        <a href={person.resume} class="btn-secondary" download>
          <Icon name="download" class="size-4" />
          Download résumé
        </a>
        <div class="ml-1 flex items-center gap-1">
          <a
            href={person.github}
            class="grid size-10 place-items-center rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
            aria-label="GitHub profile"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" />
          </a>
          <a
            href={person.linkedin}
            class="grid size-10 place-items-center rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
            aria-label="LinkedIn profile"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="linkedin" />
          </a>
          <a
            href={`mailto:${person.email}`}
            class="grid size-10 place-items-center rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
            aria-label="Send an email"
          >
            <Icon name="mail" />
          </a>
        </div>
      </div>
    </div>

    <div class="relative mx-auto w-56 sm:w-72 lg:w-80">
      <div
        class="absolute -inset-3 rounded-[2rem] bg-gradient-to-br from-cyan-400/40 via-sky-500/20 to-transparent blur-2xl"
        aria-hidden="true"
      ></div>
      <Image
        src={profilePhoto}
        alt={`Portrait of ${person.name}`}
        width={640}
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 320px, (min-width: 640px) 288px, 224px"
        loading="eager"
        fetchpriority="high"
        class="relative aspect-square w-full rounded-[1.75rem] border border-slate-200 object-cover shadow-xl dark:border-slate-800"
      />
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl px-6 pb-16">
    <dl class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="card flex flex-col-reverse p-5">
          <dt class="text-sm">{stat.label}</dt>
          <dd class="mt-1 font-mono text-3xl font-semibold text-slate-900 dark:text-white">
            {stat.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
