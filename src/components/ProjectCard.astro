---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import CanTerminal from './previews/CanTerminal.astro';
import VmuDiagram from './previews/VmuDiagram.astro';
import type { Project } from '../data/profile';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { preview } = project;
---

<article
  class:list={[
    'card group flex flex-col overflow-hidden transition-shadow hover:shadow-lg hover:shadow-slate-200/60 dark:hover:shadow-black/40',
    featured && 'lg:flex-row',
  ]}
>
  <a
    href={project.repo}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'relative block overflow-hidden border-b border-slate-200 dark:border-slate-800',
      preview.type === 'image' && 'aspect-[4/3] md:aspect-[16/10]',
      preview.type !== 'image' && 'aspect-square md:aspect-[16/10]',
      featured && 'lg:aspect-auto lg:w-[55%] lg:shrink-0 lg:border-r lg:border-b-0',
    ]}
    tabindex="-1"
    aria-hidden="true"
  >
    {preview.type === 'can-terminal' && <CanTerminal />}
    {preview.type === 'vmu-diagram' && <VmuDiagram />}
    {preview.type === 'image' && (
      <div class="grid h-full min-h-0 w-full place-items-center bg-white p-2 sm:p-3">
        <Image
          src={preview.src}
          alt={preview.alt}
          width={960}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 560px, 100vw"
          class="block h-full min-h-0 w-full object-contain"
        />
      </div>
    )}
    <span class="absolute top-3 right-3 rounded-md bg-slate-900/80 px-2 py-1 font-mono text-[11px] text-white backdrop-blur">
      {project.previewLabel}
    </span>
  </a>

  <div class:list={['flex flex-1 flex-col p-6', featured && 'lg:p-8']}>
    <p class="font-mono text-xs text-slate-500 dark:text-slate-400">{project.context}</p>
    <h3 class:list={['mt-2 font-semibold', featured ? 'text-2xl' : 'text-xl']}>{project.title}</h3>
    <p class="mt-3 leading-relaxed">{project.summary}</p>

    <ul class="mt-4 space-y-2 text-sm leading-relaxed">
      {project.highlights.map((item) => (
        <li class="flex gap-2">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-cyan-500" aria-hidden="true" />
          <span>
            {item.split('`').map((part, i) => (i % 2 === 1 ? <code>{part}</code> : part))}
          </span>
        </li>
      ))}
    </ul>

    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
      {project.stack.map((tech) => (
        <li class="chip bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          {tech}
        </li>
      ))}
    </ul>

    <div class="mt-auto pt-6">
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-cyan-700 hover:text-cyan-900 dark:text-cyan-400 dark:hover:text-cyan-300"
      >
        <Icon name="github" class="size-4" />
        View source on GitHub
        <Icon name="external" class="size-3.5" />
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</article>
