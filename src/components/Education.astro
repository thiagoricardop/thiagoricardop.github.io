---
import Section from './Section.astro';
import { certifications, education, languages } from '../data/profile';
---

<Section id="education" eyebrow="05 · Education" title="Education & credentials">
  <div class="grid gap-6 md:grid-cols-2">
    {education.map((item) => (
      <article class="card p-6">
        <p class="font-mono text-xs text-slate-500 dark:text-slate-400">{item.period}</p>
        <h3 class="mt-2 text-lg font-semibold">{item.degree}</h3>
        <p class="text-cyan-700 dark:text-cyan-400">{item.school}</p>
        <p class="text-sm text-slate-500 dark:text-slate-400">{item.location}</p>
        <p class="mt-3 text-sm leading-relaxed">{item.details}</p>
      </article>
    ))}
  </div>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div class="card p-6">
      <h3 class="font-semibold">Certifications</h3>
      <ul class="mt-4 space-y-3">
        {certifications.map((cert) => (
          <li class="flex items-baseline justify-between gap-4">
            <span>
              {cert.name}
              <span class="block text-sm text-slate-500 dark:text-slate-400">{cert.issuer}</span>
            </span>
            <span class="font-mono text-sm text-slate-500 dark:text-slate-400">{cert.year}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="card p-6">
      <h3 class="font-semibold">Languages</h3>
      <dl class="mt-4 space-y-3">
        {languages.map((language) => (
          <div class="flex items-baseline justify-between gap-4">
            <dt>{language.name}</dt>
            <dd class="text-sm text-slate-500 dark:text-slate-400">{language.level}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</Section>
