---
import Section from './Section.astro';
import { experience, leadership } from '../data/profile';
---

<Section id="experience" eyebrow="03 · Experience" title="Professional experience">
  <ol class="relative space-y-10 border-l border-slate-200 pl-8 dark:border-slate-800">
    {experience.map((job) => (
      <li class="relative">
        <span
          class="absolute top-1.5 -left-[2.4rem] size-3 rounded-full border-2 border-cyan-500 bg-white dark:bg-slate-950"
          aria-hidden="true"
        />
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-lg font-semibold">
            {job.role}
            <span class="font-normal text-slate-500 dark:text-slate-400"> · {job.company}</span>
          </h3>
          <p class="font-mono text-sm text-slate-500 dark:text-slate-400">{job.period}</p>
        </div>
        <p class="text-sm text-slate-500 dark:text-slate-400">{job.location}</p>
        <ul class="mt-3 space-y-2 leading-relaxed">
          {job.highlights.map((item) => (
            <li class="flex gap-3">
              <span
                class="mt-2.5 size-1.5 shrink-0 rounded-full bg-slate-400 dark:bg-slate-600"
                aria-hidden="true"
              />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <ul class="mt-3 flex flex-wrap gap-2" aria-label="Skills used">
          {job.skills.map((skill) => (
            <li class="chip bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
              {skill}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>

  <div class="card mt-12 p-6">
    <p class="font-mono text-xs text-slate-500 dark:text-slate-400">Leadership</p>
    <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-lg font-semibold">{leadership.role}</h3>
      <p class="font-mono text-sm text-slate-500 dark:text-slate-400">{leadership.period}</p>
    </div>
    <p class="text-sm text-slate-500 dark:text-slate-400">{leadership.org}</p>
    <p class="mt-3 leading-relaxed">{leadership.summary}</p>
  </div>
</Section>
