---
import Icon from './Icon.astro';
import Section from './Section.astro';
import { person } from '../data/profile';
---

<Section id="contact" eyebrow="06 · Contact" title="Let's work together">
  <div class="card relative overflow-hidden p-8 sm:p-12">
    <div
      class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-cyan-400/20 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative max-w-2xl">
      <p class="text-lg leading-relaxed">
        I am looking for entry-level roles in automotive cybersecurity, embedded and product
        security, and embedded software.
      </p>
      <p class="mt-3 flex items-center gap-2 font-medium text-slate-900 dark:text-white">
        <Icon name="shieldCheck" class="size-5 text-emerald-600 dark:text-emerald-400" />
        {person.workAuthorization} · {person.availability}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`mailto:${person.email}`} class="btn-primary">
          <Icon name="mail" class="size-4" />
          {person.email}
        </a>
        <a href={person.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          <Icon name="linkedin" class="size-4" />
          LinkedIn
        </a>
        <a href={person.github} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          <Icon name="github" class="size-4" />
          GitHub
        </a>
        <a href={person.resume} class="btn-secondary" download>
          <Icon name="download" class="size-4" />
          Résumé (PDF)
        </a>
      </div>
    </div>
  </div>
</Section>
